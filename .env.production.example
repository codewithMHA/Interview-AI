# ==========================================
# InterviewAI Production Environment
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://your-domain.com

# Database Connection
# In Docker: mongodb://mongo:27017/interviewai
# On Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/interviewai
MONGODB_URI=mongodb://mongo:27017/interviewai

# Security
JWT_SECRET=super_strong_cryptographic_jwt_secret_key_minimum_32_characters

# Google Gemini AI API Key
GEMINI_API_KEY=AIzaSy...

# Judge0 Code Execution API (RapidAPI or Self-Hosted)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_judge0_key

