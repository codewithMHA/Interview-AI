# Server Environment Variables
NODE_ENV=development
PORT=5000
# Supports comma-separated origins for production/preview URLs
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Connection String (Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/interview_ai

# Authentication (MUST change in production)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Judge0 Code Execution API (Optional — recommended for multi-language execution in cloud/Docker)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# Frontend Build Variable (Leave unset for unified server or Nginx /api proxy; set when hosting client separately)
# VITE_API_URL=https://your-api-domain.com/api

